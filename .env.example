# ==============================================================================
# CV Pelangi UV - Environment Variables Example
# Salin berkas ini menjadi .env.local untuk pengembangan lokal
# ==============================================================================

# Kunci API Asisten Chatbot AI (Groq Cloud API)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Kredensial Login Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# (Opsional) URL Database PostgreSQL (Neon / Supabase / Render / Local)
# Jika dikosongkan, sistem otomatis menggunakan penyimpanan data JSON lokal
DATABASE_URL=
